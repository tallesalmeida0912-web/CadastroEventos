<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CadastroEventos.Views.ResumoEvento"
    
    BackgroundColor="{StaticResource Gray200}">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label
                Text="Evento cadastrado!"
                FontSize="27"
                FontAttributes="Bold"
                TextColor="#20304A"
                HorizontalOptions="Center"/>

            <Label
                Text="Confira os dados do seu evento"
                FontSize="14"
                TextColor="Gray"
                HorizontalOptions="Center"/>

            <Border
                BackgroundColor="White"
                
                Stroke="Black"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 15">

                <VerticalStackLayout Spacing="14">

                    <Label Text="INFORMAÇÕES DO EVENTO"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#2864D7"/>

                    <Label Text="Nome do evento"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding Nome}"
                           FontSize="16"
                           TextColor="Gray"/>

                    <Label Text="Data de início"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="Gray"/>

                    <Label Text="Data de término"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="Gray"/>

                    <Label Text="Local"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding Local}"
                           TextColor="Gray"/>

                    <Label Text="Número de participantes"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding NumeroParticipantes}"
                           TextColor="Gray"/>

                    <BoxView HeightRequest="1"
                             Color="#DCE2EC"/>

                    <Label Text="Duração do evento"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding DuracaoEmDias, StringFormat='{}{0} dias'}"
                           FontSize="18"
                           TextColor="#2864D7"
                           FontAttributes="Bold"/>

                    <Label Text="Custo por participante"
                           FontAttributes="Bold"
                           TextColor="#20304A"/>
                    <Label Text="{Binding CustoPorParticipante, StringFormat='R$ {0:N2}'}"
                           TextColor="Gray"/>

                    <Label Text="CUSTO TOTAL DO EVENTO"
                           FontAttributes="Bold"
                           TextColor="#20304A"
                           FontSize="14"/>

                    <Label Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="#16834A"/>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="VOLTAR AO CADASTRO"
                Clicked="OnVoltarClicked"
                BackgroundColor="White"
                TextColor="Black"
                BorderColor="Black"
                BorderWidth="1"
                FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="55"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
